# =====================================
# FRIDAY AI ENVIRONMENT CONFIGURATION
# =====================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7
OPENAI_ORG_ID=your_openai_org_id_here
OPENAI_PROJECT=your_openai_project_id_here

# SerpAPI Configuration (for web search features)
# Get your API key from: https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# GitHub Configuration
# Create a personal access token: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fridayai
DB_USER=your_db_username_here
DB_PASSWORD=your_db_password_here

# Security Settings
# Generate encryption keys using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEMORY_ENCRYPTION_KEY=your_base64_encryption_key_here
VAULT_ENCRYPTION_KEY=your_base64_encryption_key_here

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
