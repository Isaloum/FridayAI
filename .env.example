# ========================================
# FridayAI Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ========================================
# OpenAI Configuration
# ========================================
OPENAI_API_KEY=sk-proj-your_actual_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# ========================================
# Database Configuration
# ========================================
# PostgreSQL (Production)
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here

# SQLite (Development)
SQLITE_DB_PATH=./friday_local.db

# ========================================
# GitHub Configuration (Optional)
# ========================================
GITHUB_TOKEN=your_github_personal_access_token_here

# ========================================
# Encryption Keys
# ========================================
# Generate with: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
MEMORY_ENCRYPTION_KEY=generate_a_fernet_key_here
VAULT_ENCRYPTION_KEY=generate_a_fernet_key_here

# ========================================
# API Server Configuration
# ========================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5050
FLASK_DEBUG=False
FLASK_SECRET_KEY=generate_random_secret_key_here

# ========================================
# Feature Flags
# ========================================
ENABLE_VOICE=False
ENABLE_WEB_SEARCH=False
ENABLE_PREGNANCY_MODE=True

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL=INFO
LOG_FILE=friday_activity.log

# ========================================
# LangChain Configuration (Optional)
# ========================================
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=FridayAI
LANGCHAIN_TRACING_V2=false

# ========================================
# Neo4j Configuration (Optional)
# ========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ========================================
# IMPORTANT SECURITY NOTES
# ========================================
# 1. NEVER commit this file with real values to git
# 2. Use strong, unique passwords for all services
# 3. Rotate API keys and passwords regularly
# 4. Store production secrets in secure secret management (AWS Secrets Manager, etc.)
# 5. Use different credentials for development and production
